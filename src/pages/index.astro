---
import "../styles/global.css";

const profile = {
  name: "Rolands Prohorovs",
  role: "Industrial Information Technology Student",
  location: "Lahti, Finland",
  email: "roland.prohorov@inbox.lv",
  phone: "+371 20 629 639",
  phoneLink: "+37120629639",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`${profile.name}'s software development portfolio and CV.`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{profile.name} — {profile.role}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="#top" aria-label={`${profile.name}, home`}>
          <span class="wordmark-mark" aria-hidden="true">R</span>
          <span>{profile.name}</span>
        </a>

        <nav aria-label="Primary navigation">
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="/work">Work</a>
        </nav>

        <a class="header-cta" href={`mailto:${profile.email}`}>Let’s talk <span aria-hidden="true">↗</span></a>
      </header>

      <main id="top">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span></span> Based in {profile.location}</p>
            <h1 id="hero-title">I build thoughtful<br />digital <em>experiences.</em></h1>
            <p class="intro">
              I’m {profile.name}, a third-year Industrial Information Technology student at LAB University
              of Applied Sciences, focused on building clear and reliable digital solutions.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="/work">Explore my work <span aria-hidden="true">→</span></a>
              <a class="text-link" href={`mailto:${profile.email}`}>Email me <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <aside class="profile-card" aria-label="Profile summary">
            <div class="portrait">
              <img
                src="/rolands-prohorovs.jpg"
                alt="Rolands Prohorovs standing inside an ornate historic building"
                width="1170"
                height="1523"
              />
            </div>
            <div class="profile-meta">
              <div>
                <span class="label">Education</span>
                <strong>LAB University of Applied Sciences</strong>
                <span class="profile-detail">Third-year student · Lahti, Finland</span>
              </div>
              <span class="status-dot" title="Available"></span>
            </div>
            <div class="contact-list" aria-label="Contact details">
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
              <a href={`tel:${profile.phoneLink}`}>{profile.phone}</a>
            </div>
          </aside>
        </section>

        <div class="hero-footer" aria-label="Highlights">
          <p>Code with purpose.</p>
          <p>Design with clarity.</p>
          <p>Build for people.</p>
        </div>
      </main>
    </div>
  </body>
</html>

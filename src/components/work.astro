---
// src/components/WorkExperience.astro
const jobs = [
  {
    role: "Lifeguard",
    place: "Liepaja, Latvia",
    period: "May 2026 – September 2026",
    details: [
      "Provide first aid",
      "Monitor swimming areas",
      "Educate visitors on water safety",
      "Perform rescue duties",
    ],
  },
  {
    role: "Bartender",
    place: "Restaurant Postman's House, Liepaja, Latvia",
    period: "May 2025 – August 2025",
    details: [
      "Prepared cocktails and other beverages",
      "Received and checked alcohol deliveries",
    ],
  },
  {
    role: "Bartender",
    place: "Restaurant Postman's House, Liepaja, Latvia",
    period: "February 2024 – August 2024",
    details: [
      "Prepared cocktails and other beverages",
      "Received and checked alcohol deliveries",
    ],
  },
  {
    role: "Dishwasher, Kitchen Assistant",
    place: "Restaurant Postman's House, Liepaja, Latvia",
    period: "June 2023 – August 2023",
    details: ["Washed dishes", "Assisted in the kitchen", "Cleaned the kitchen"],
  },
  {
    role: "Construction Worker",
    place: "ParketPartner, Oslo, Norway",
    period: "August 2022",
    details: ["Installed parquet flooring"],
  },
  {
    role: "Groundskeeper, Kitchen Assistant, Construction Worker",
    place: "Verbelnieki Recreation Complex, Liepaja, Latvia",
    period: "June 2022 – July 2022",
    details: ["Assisted in the kitchen", "Mowed lawns", "Helped build a shed"],
  },
];
---

<section id="experience" class="exp-section">
  <div class="exp-header">
    <span class="exp-label">WORK</span>
    <h2>Work <em>experience.</em></h2>
  </div>

  <ol class="exp-grid">
    {jobs.map((job) => (
      <li class="exp-card">
        <p class="exp-period">{job.period}</p>
        <h3>{job.role}</h3>
        <p class="exp-place">{job.place}</p>
        <ul>
          {job.details.map((d) => <li>{d}</li>)}
        </ul>
      </li>
    ))}
  </ol>
</section>

<style>
  /* Adjust these to match your global.css palette */
  .exp-section {
    --exp-bg: var(--bg, #0b0b0b);
    --exp-text: var(--text, #f2f2f2);
    --exp-muted: rgba(242, 242, 242, 0.6);
    --exp-line: rgba(242, 242, 242, 0.18);
    --exp-card-bg: rgba(242, 242, 242, 0.04);
    --exp-accent: var(--accent, #ffffff);

    background: var(--exp-bg);
    color: var(--exp-text);
    padding: clamp(4rem, 9vw, 8rem) clamp(1.25rem, 6vw, 6rem);
  }

  .exp-header {
    max-width: 1100px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
  }

  .exp-label {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--exp-muted);
    margin-bottom: 0.75rem;
  }

  .exp-header h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    margin: 0;
  }
  .exp-header h2 em {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    margin: 0;
    color: #c8ff32;
  }

  /* 3 columns x 2 rows */
  .exp-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1100px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 1fr; /* equal-height rows */
    gap: 1.25rem;
  }

  .exp-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--exp-card-bg);
    border: 1px solid var(--exp-line);
    border-radius: 12px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .exp-card:hover {
    border-color: var(--exp-accent);
    transform: translateY(-2px);
  }

  .exp-period {
    margin: 0 0 0.75rem;
    color: var(--exp-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .exp-card h3 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
    line-height: 1.25;
    color: #c8ff32;
  }

  .exp-place {
    margin: 0 0 1rem;
    color: var(--exp-muted);
    font-size: 0.9rem;
  }

  .exp-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  .exp-card li {
    position: relative;
    padding-left: 1.1rem;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  .exp-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.4rem;
    height: 1px;
    background: var(--exp-accent);
  }

  @media (max-width: 960px) {
    .exp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .exp-grid {
      grid-template-columns: 1fr;
    }
  }
</style>